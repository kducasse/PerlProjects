#!/usr/bin/perl -w
use strict;

$^I = ".out"; # Magical variable in conjuction with '<>'

while (<>) {
    chomp;
    s/Fred/\n/ig; # Replace all Freds with a new line
    s/Wilma/Fred/ig;
    s/\n/Wilma/g;
    $_ .= "\n";
    # 'print;' will continue to modify the file because, 
    # when $^I is set, print writes to the file being edited.
    print;
    print STDOUT $_; # This prints the modified line to the console
}